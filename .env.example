# TruthLens Local Configuration (.env)
# Copy this file to .env (or backend/.env) and fill in your GCP resource details.

# 1. Google Cloud Project ID
PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# 2. Google Cloud Storage Bucket for TruthLens videos
# Example: your-project-id-truthlens-videos
BUCKET=your-truthlens-videos-bucket

# 3. Google Cloud Firestore Database (defaults to "(default)")
FIRESTORE_DATABASE_ID=(default)

# 4. Fallback Gemini AI Studio API Key (optional)
# Visitors can bring their own API key in UI Settings; this key is only used as a server fallback.
GEMINI_API_KEY=

# 5. Default Fallback Model (optional)
MODEL=gemini-3.8-flash

# 6. Backend API Port (optional, defaults to 8080)
PORT=8080
